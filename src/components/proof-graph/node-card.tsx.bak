"use client";

import { motion } from "framer-motion";
import { kindMeta, strengthMeta, type ProofNode, type ProofRole, priorityForRole } from "./proof-data";

export function NodeCard({
  activeRole,
  node,
  onSelect,
  selected,
}: {
  activeRole: ProofRole;
  node: ProofNode;
  onSelect: () => void;
  selected: boolean;
}) {
  const kind = kindMeta[node.kind];
  const strength = strengthMeta[node.strength];
  const KindIcon = kind.Icon;
  const priority = priorityForRole(node.viewerPriority, activeRole);

  // We tone down opacity for lower priority nodes unless selected
  const opacity = selected ? 1 : priority === "high" ? 1 : priority === "medium" ? 0.8 : 0.6;
  const scale = selected ? 1.02 : 1;

  return (
    <motion.button
      onClick={onSelect}
      layout
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity, y: 0 }}
      viewport={{ once: true, margin: "-50px" }}
      whileHover={{
        scale: 1.02,
        y: -4,
        opacity: 1,
        transition: { type: "spring", stiffness: 300, damping: 20 },
      }}
      whileTap={{ scale: 0.98 }}
      className={`group relative flex w-full flex-col items-start gap-4 rounded-3xl border p-5 text-left transition-colors duration-500 ease-out sm:p-6
        ${selected
          ? "border-[var(--color-antique-gold)] bg-white/80 shadow-[0_12px_40px_rgba(212,175,55,0.15)] ring-1 ring-[var(--color-antique-gold)] backdrop-blur-2xl"
          : "border-black/5 bg-white/40 shadow-[0_8px_30px_rgba(0,0,0,0.04)] backdrop-blur-xl hover:border-black/10 hover:bg-white/60 hover:shadow-[0_16px_50px_rgba(0,0,0,0.06)]"
        }`}
    >
      <div className="flex w-full items-center justify-between">
        <span
          className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium tracking-wide ${kind.badge} bg-black/5`}
        >
          <KindIcon className="h-3.5 w-3.5" />
          {kind.label}
        </span>
        <span className="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--color-obsidian)]/50">
          {priority}
        </span>
      </div>

      <div className="space-y-1.5">
        <h3
          className={`font-semibold leading-tight tracking-tight text-[var(--color-obsidian)] ${
            selected ? "text-xl sm:text-2xl" : "text-lg sm:text-xl"
          }`}
        >
          {node.label}
        </h3>
        <p className="text-sm leading-relaxed text-[var(--color-obsidian)]/70 line-clamp-2">
          {node.summary}
        </p>
      </div>

      {selected && (
        <motion.div
          initial={{ opacity: 0, height: 0 }}
          animate={{ opacity: 1, height: "auto" }}
          className="mt-2 space-y-4 border-t border-black/5 pt-4"
        >
          <p className="text-sm text-[var(--color-obsidian)]/80">{node.detail}</p>
          <div className="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-[var(--color-obsidian)]/50">
            <strength.Icon className="h-4 w-4" />
            <span>Proof: {strength.label}</span>
          </div>
        </motion.div>
      )}

      {/* Decorative premium glow effect on hover */}
      <div className="pointer-events-none absolute inset-0 -z-10 rounded-3xl bg-gradient-to-br from-[var(--color-champagne)]/0 via-[var(--color-silk)]/0 to-[var(--color-antique-gold)]/0 opacity-0 transition-opacity duration-700 ease-out group-hover:opacity-10" />
    </motion.button>
  );
}
