"use client";

import { motion, useScroll, useTransform } from "framer-motion";
import { useRef } from "react";
import { type ProofCluster, type ProofNode, type ProofRole, laneLabels, type ProofLane } from "./proof-data";
import { NodeCard } from "./node-card";

export function ScrollCluster({
  cluster,
  activeRole,
  nodeCatalog,
  selectedNodeId,
  onSelectNode,
}: {
  cluster: ProofCluster;
  activeRole: ProofRole;
  nodeCatalog: Map<string, ProofNode>;
  selectedNodeId: string;
  onSelectNode: (id: string) => void;
}) {
  const containerRef = useRef<HTMLElement>(null);
  const { scrollYProgress } = useScroll({
    target: containerRef,
    offset: ["start end", "end start"],
  });

  // Subtle parallax for the text
  const y = useTransform(scrollYProgress, [0, 1], ["-10%", "10%"]);
  const opacity = useTransform(scrollYProgress, [0, 0.2, 0.8, 1], [0, 1, 1, 0]);

  return (
    <section ref={containerRef} className="relative w-full min-h-screen py-24 sm:py-32">
      <div className="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="flex flex-col gap-16 lg:flex-row lg:items-start lg:gap-24">
          
          {/* Sticky Left Content */}
          <motion.div
            style={{ y, opacity }}
            className="lg:sticky lg:top-40 lg:w-1/3"
          >
            <h2 className="font-mono text-sm uppercase tracking-widest text-[var(--color-antique-gold)]">
              {cluster.shortTitle}
            </h2>
            <h3 className="mt-4 text-4xl font-light tracking-tight text-[var(--color-obsidian)] sm:text-5xl lg:text-6xl">
              {cluster.title}
            </h3>
            <p className="mt-6 text-lg leading-relaxed text-[var(--color-obsidian)]/70">
              {cluster.summary}
            </p>
            <p className="mt-4 text-base leading-relaxed text-[var(--color-obsidian)]/50">
              {cluster.claim}
            </p>
          </motion.div>

          {/* Scrolling Right Content: Nodes by Lane */}
          <div className="lg:w-2/3 space-y-24">
            {(["claim", "proof", "support"] as ProofLane[]).map((lane) => {
              const nodeIds = cluster.lanes[lane];
              if (!nodeIds || nodeIds.length === 0) return null;

              return (
                <div key={lane} className="relative">
                  {/* Elegant decorative line connecting sections */}
                  <div className="absolute left-6 top-10 -bottom-24 w-px bg-gradient-to-b from-black/5 via-black/10 to-transparent hidden sm:block" />
                  
                  <h4 className="mb-8 font-mono text-xs uppercase tracking-widest text-[var(--color-obsidian)]/40 relative sm:pl-16">
                    <span className="hidden sm:inline-block absolute left-5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full border-2 border-[var(--color-antique-gold)] bg-white" />
                    {laneLabels[lane]}
                  </h4>

                  <div className="space-y-6 sm:pl-16">
                    {nodeIds.map((nodeId) => {
                      const node = nodeCatalog.get(nodeId);
                      if (!node) return null;

                      return (
                        <NodeCard
                          key={node.id}
                          activeRole={activeRole}
                          node={node}
                          selected={selectedNodeId === node.id}
                          onSelect={() => onSelectNode(node.id)}
                        />
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>

        </div>
      </div>
    </section>
  );
}
