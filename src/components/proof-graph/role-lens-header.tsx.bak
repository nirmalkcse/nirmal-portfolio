"use client";

import { motion } from "framer-motion";
import { roleFilters, type RoleFilter } from "./proof-data";

export function RoleLensHeader({
  activeRole,
  onSelectRole,
}: {
  activeRole: RoleFilter;
  onSelectRole: (role: RoleFilter) => void;
}) {
  return (
    <header className="sticky top-0 z-50 flex justify-center py-6 px-4">
      <motion.div
        initial={{ y: -50, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        transition={{ type: "spring", stiffness: 300, damping: 30 }}
        className="flex items-center gap-1 sm:gap-2 rounded-full border border-black/5 bg-white/60 p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.06)] backdrop-blur-2xl"
      >
        {roleFilters.map((filter) => {
          const isActive = activeRole === filter.id;
          const Icon = filter.Icon;

          return (
            <button
              key={filter.id}
              onClick={() => onSelectRole(filter.id)}
              className={`relative flex items-center justify-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium transition-colors duration-300 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-antique-gold)] ${
                isActive ? "text-[var(--color-obsidian)]" : "text-[var(--color-obsidian)]/50 hover:text-[var(--color-obsidian)]/80"
              }`}
            >
              {isActive && (
                <motion.div
                  layoutId="activeRoleIndicator"
                  className="absolute inset-0 z-0 rounded-full bg-white shadow-sm ring-1 ring-black/5"
                  transition={{ type: "spring", stiffness: 400, damping: 30 }}
                />
              )}
              <span className="relative z-10 flex items-center gap-2">
                <Icon className="h-4 w-4" />
                <span className="hidden sm:inline">{filter.label}</span>
              </span>
            </button>
          );
        })}
      </motion.div>
    </header>
  );
}
